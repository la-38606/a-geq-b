      "category": "in_scope_sos",
      "expected": "PROVED",
      "domain": "all reals",
      "source": "positive-definite quadratic form",
      "sos": [{"coeff": "1", "poly": "x + 1/2*y"}, {"coeff": "3/4", "poly": "y"}],
      "notes": "(x + y/2)^2 + (3/4) y^2."
