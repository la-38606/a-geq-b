      "degree": 2,
      "category": "in_scope_sos",
      "expected": "PROVED",
      "domain": "all reals",
      "source": "positive-semidefinite quadratic form",
      "sos": [{"coeff": "1/2", "poly": "a + b"}, {"coeff": "1/2", "poly": "b + c"}, {"coeff": "1/2", "poly": "a + c"}],
