      "domain": "all reals",
      "source": "completing the square",
      "sos": [{"coeff": "1", "poly": "a - 1/2*b"}, {"coeff": "3/4", "poly": "b"}],
      "notes": "(a - b/2)^2 + (3/4) b^2 = a^2 - ab + b^2."
    },
    {
      "id": "quad-xy-form",
